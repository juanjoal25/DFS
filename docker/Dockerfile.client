FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY common ./common
COPY client ./client
COPY scripts ./scripts

# Wrapper para invocar la CLI como simplemente `dfs ...`
RUN printf '#!/bin/sh\nexec python -m client.cli "$@"\n' > /usr/local/bin/dfs \
    && chmod +x /usr/local/bin/dfs

ENTRYPOINT ["python", "-m", "client.cli"]
